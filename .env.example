# Local/demo defaults
AUTH_MODE=demo
DATABASE_URL=sqlite:///backend/database/agronexus.db

# Required when AUTH_MODE=required (generate a long random value)
JWT_SECRET=
JWT_TTL_MINUTES=60
RESET_TOKEN_TTL_MINUTES=30
RATE_LIMIT_PER_MINUTE=60
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional live weather provider. The adapter falls back to local estimates.
WEATHER_PROVIDER_URL=
WEATHER_PROVIDER_API_KEY=
WEATHER_CACHE_TTL_MINUTES=30
WEATHER_TIMEOUT_SECONDS=5
